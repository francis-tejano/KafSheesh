# Defaults for local `pnpm dev` and for Docker when `.env` is absent.
# Compose loads this file, then overlays `.env` if you create one.
# The API container always uses KAFSHEESH_DATA_DIR=/data regardless of this value.
PORT=4000
KAFSHEESH_DATA_DIR=./apps/api/data
KAFSHEESH_MASTER_KEY=change-me-in-production
KAFSHEESH_TLS_REJECT_UNAUTHORIZED=true
KAFSHEESH_WEB_PORT=4444
KAFSHEESH_DISABLE_DESTRUCTIVE=true
# Leave unset for JSON files under KAFSHEESH_DATA_DIR (pnpm dev).
# Compose sets this to the bundled Postgres service.
# DATABASE_URL=postgres://kafsheesh:kafsheesh@127.0.0.1:5432/kafsheesh
POSTGRES_PASSWORD=kafsheesh
